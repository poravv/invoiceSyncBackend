# Configuración básica (compatibilidad hacia atrás)
EMAIL_HOST=mail.example.com
EMAIL_PORT=993
EMAIL_USE_SSL=True
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-password-here

# Configuración de OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Configuración de archivos
EXCEL_OUTPUT_PATH=./data/facturas.xlsx
EXCEL_OUTPUT_DIR=./data/excels
TEMP_PDF_DIR=./data/temp_pdfs
LOG_LEVEL=INFO

# Configuración de la API
API_HOST=0.0.0.0
API_PORT=8000

# Configuración del Job
JOB_INTERVAL_MINUTES=5
EMAIL_SEARCH_CRITERIA=UNSEEN
EMAIL_SEARCH_TERMS=["factura","facturacion","factura electronica","comprobante","documento electrónico","documento electronico"]

# Configuración de múltiples correos (JSON)
# Los search_terms se heredan automáticamente de EMAIL_SEARCH_TERMS
# Solo especifica search_terms si necesitas términos diferentes para esa cuenta específica
EMAILS_CONFIG=[
  {
    "name": "Correo Principal",
    "host": "mail.empresa.com",
    "port": 993,
    "username": "facturas@empresa.com",
    "password": "contraseña123",
    "use_ssl": true,
    "search_criteria": "UNSEEN",
    "provider": "other",
    "enabled": true
  },
  {
    "name": "Gmail Empresarial",
    "host": "imap.gmail.com",
    "port": 993,
    "username": "admin@empresa.com",
    "password": "contraseña_app_gmail",
    "use_ssl": true,
    "search_criteria": "UNSEEN",
    "search_terms": ["factura", "comprobante"],
    "provider": "gmail",
    "enabled": true
  }
]

# NOTAS IMPORTANTES:
# 1. Para Gmail, necesitas usar "Contraseñas de aplicación" en lugar de tu contraseña normal
# 2. Para Outlook/Office365, asegúrate de que IMAP esté habilitado
# 3. El campo "provider" ayuda a aplicar configuraciones automáticas:
#    - "gmail": Aplica configuración automática para Gmail
#    - "outlook": Aplica configuración automática para Outlook
#    - "other": Usa la configuración manual proporcionada
# 4. Si EMAILS_CONFIG está vacío, se usará la configuración básica como fallback
# 5. search_terms es OPCIONAL: si no se especifica, usa EMAIL_SEARCH_TERMS global
# 6. Solo especifica search_terms si necesitas términos diferentes para esa cuenta específica
